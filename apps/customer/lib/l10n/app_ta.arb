  "faqProfileA": "சுயவிவரத்தைத் திறந்து மேலே உங்கள் பெயரைத் தட்டி, விவரங்களை மாற்றி மாற்றங்களைச் சேமி என்பதைத் தட்டுங்கள்.",
  "faqDeleteQ": "என் கணக்கை எப்படி நீக்குவது?",
  "faqDeleteA": "சுயவிவரம் → தனிப்பட்ட தகவல் → கணக்கை நீக்கு என்பதற்குச் சென்று படிகளைப் பின்பற்றுங்கள். உங்கள் மொபைல் எண்ணுக்கு அனுப்பப்படும் குறியீட்டுடன் உறுதிசெய்வீர்கள்.",
  "faqBookQ": "தொழில்நுட்பவியலாளரை எப்படி முன்பதிவு செய்வது?",
  "faqBookA": "முகப்புத் திரையில் ஒரு சேவையைத் தேர்ந்தெடுத்து, பிரச்சினையை விவரித்து, இடத்தைத் தேர்ந்தெடுத்து உறுதிசெய்யுங்கள். சரிபார்க்கப்பட்ட தொழில்நுட்பவியலாளருடன் உங்களைப் பொருத்துவோம்.",
  "faqEmergencyQ": "அவசர முன்பதிவுகள் எப்படிச் செயல்படுகின்றன?",
  "faqEmergencyA": "அவசரக் கோரிக்கைகள் உடனே அருகிலுள்ள கிடைக்கக்கூடிய தொழில்நுட்பவியலாளருக்குச் செல்லும். முன்பதிவு செய்யும்போது அவசரம் என்பதைத் தேர்ந்தெடுங்கள்.",
  "faqScheduledQ": "திட்டமிட்ட முன்பதிவுகள் எப்படிச் செயல்படுகின்றன?",
  "faqScheduledA": "ஒரு நாளையும் வருகை நேர இடைவெளியையும் தேர்ந்தெடுங்கள். தொழில்நுட்பவியலாளர் முந்தைய நாள் வருகையை உறுதிசெய்வார்; 2 மணி நேரத்திற்கு முன் வரை இலவசமாக மாற்றியமைக்கலாம்.",
  "faqMeasureQ": "அளவீட்டுக் கோரிக்கை என்றால் என்ன?",
  "faqMeasureA": "வேலை தொடங்கும் முன் தொழில்நுட்பவியலாளர் ஆய்வு செய்து, அளந்து, மதிப்பீடு தரும் ஒரு வருகை.",
  "faqMethodsQ": "எந்த கட்டண முறைகள் ஆதரிக்கப்படுகின்றன?",
  "faqMethodsA": "வேலை முடிந்ததும் பணமாகச் செலுத்தலாம். அட்டை மற்றும் ஆன்லைன் கட்டணங்கள் விரைவில் வருகின்றன.",
  "faqRefundQ": "பணத்தைத் திரும்பப் பெறுதல் எப்படிச் செயல்படுகிறது?",
  "faqRefundA": "தவறுதலாகக் கட்டணம் வசூலிக்கப்பட்டால், உதவி & ஆதரவு → கட்டணச் சிக்கல் என்பதைத் திறந்து முன்பதிவைச் சொல்லுங்கள். ஒவ்வொரு கோரிக்கையையும் மதிப்பாய்வு செய்கிறோம்.",
