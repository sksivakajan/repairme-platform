POSTGRES_USER=repairme
POSTGRES_PASSWORD=change_me
POSTGRES_DB=repairme_dev
POSTGRES_PORT=5432

DATABASE_URL=postgresql://repairme:change_me@localhost:5432/repairme_dev

# API (optional, defaults shown)
NODE_ENV=development
PORT=3000

# Auth / development tools (never enable these in production)
# Firebase project whose ID tokens the API accepts, e.g. repairme-dev
FIREBASE_PROJECT_ID=
# Accept "Authorization: Dev +94..." instead of a Firebase token
AUTH_DEV_BYPASS=false
# Expose /v1/dev endpoints that simulate technicians and operators
DEV_TOOLS=false
